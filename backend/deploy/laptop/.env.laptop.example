# Laddu Gopal Enterprise — laptop backend settings.
# copy .env.laptop.example .env   then fill in. Never commit .env.

# ── Database (the postgres container) ────────────────────
POSTGRES_USER=laddugopal
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=laddu_gopal
# DATABASE_URL is built by docker-compose.laptop.yml from the three values above.

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Admin login (the "Admin login" link in the site footer) ──
ADMIN_EMAIL=owner@example.com
ADMIN_PASSCODE=use-a-long-random-passcode

# ── SMTP: new-lead emails + weekly report ────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASSWORD=your-smtp-key
# Must be a sender verified with your SMTP provider
SMTP_FROM_EMAIL=noreply@your-verified-domain.com
SMTP_FROM_NAME=Laddu Gopal Enterprise Lead
LEAD_EMAIL=owner@example.com
REPORT_EMAIL=owner@example.com

# ── CORS: website addresses allowed to call this API (comma-separated) ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://laddugopalwelding.com
